{
  "manifest_version": 3,
  "name": "Toolker Subtitle Companion",
  "version": "1.0.0",
  "description": "Enables 100% authentic, residential YouTube subtitle extraction for Toolker Shadowing Studio.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://toolker.stratom.bond/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://toolker.stratom.bond/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Toolker Subtitle Companion",
    "default_popup": "popup.html"
  }
}
